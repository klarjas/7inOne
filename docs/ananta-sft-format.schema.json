{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://7inone.example/schemas/ananta-sft-record.schema.json",
  "title": "ANANTA supervised fine-tuning record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_lesson_id",
    "category",
    "difficulty",
    "review_status",
    "split",
    "messages"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_lesson_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "rejected"
      ]
    },
    "split": {
      "type": "string",
      "enum": [
        "train",
        "validation",
        "test",
        "unassigned"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
