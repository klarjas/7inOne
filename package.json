{
  "name": "ecomstore",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend",
    "start": "node backend/server.js",
    "check": "node scripts/build-marketplace-assets.mjs && node --check scripts/build-marketplace-assets.mjs && node --check backend/server.js && node --check backend/my-posts.js && node --check frontend/public/marketplace/app.js",
    "prebuild": "node scripts/build-marketplace-assets.mjs && node scripts/build-marketplace-css.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "postcss": "^8.5.6",
    "tailwindcss-v3": "npm:tailwindcss@3.4.17"
  },
  "overrides": {
    "csstype": "3.2.3"
  }
}
