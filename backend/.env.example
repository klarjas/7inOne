NODE_ENV=development
PORT=10000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Safe browser key; used to exchange the one-time generated Supabase magic-link token for a session.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Optional public bot username for Telegram Login Widget; if omitted, backend resolves it with getMe.
# TELEGRAM_BOT_USERNAME=YourBotUsername
# Private Telegram channel ID used for all uploaded marketplace media
TELEGRAM_STORAGE_CHAT_ID=-1000000000000
# Legacy fallback only; prefer TELEGRAM_STORAGE_CHAT_ID
# TELEGRAM_CHANNEL_ID=-1000000000000
AUTO_APPROVE_PRODUCTS=false
# Optional, comma-separated origins when serving the API cross-origin
# FRONTEND_ORIGIN=https://your-domain.example

# Random 32–256 character secret used to authenticate Telegram webhook updates.
TELEGRAM_WEBHOOK_SECRET=
# Optional public HTTPS base URL; if omitted, the backend uses the incoming Render host.
# PUBLIC_APP_URL=https://your-service.onrender.com

# Temporary bootstrap key for first-time Admin Telegram linking; remove after Admin has linked Telegram.
ADMIN_TELEGRAM_BOOTSTRAP_KEY=
